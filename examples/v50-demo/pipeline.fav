import kafka
import "./stages/validate" as validate

type RawOrder = { id: Int, amount: Float, status: String }
type Order    = { id: Int, amount: Float, status: String }

// Kafka から注文を受信
stage Consume: Unit -> Result<RawOrder, String> = |_| {
    kafka.consume("orders")
}

// バリデーション
stage Validate: RawOrder -> Result<Order, String> = |raw| {
    validate.run(raw)
}

seq OrderIngestion = Consume |> Validate

#[test]
fn test_validate_ok() {
    bind order <- validate.run({ id: 1, amount: 100.0, status: "pending" })
    assert_eq(order.status, "pending")
}

#[test]
fn test_validate_err_status() {
    match validate.run({ id: 2, amount: 50.0, status: "shipped" }) {
        Ok(_)    -> assert_eq(true, false)
        Err(msg) -> assert_eq(msg, "invalid status")
    }
}
