import rune "otel"
import src/stages
import src/validators
import src/notifications
import src/types

fn main(ctx: AppCtx) -> Unit {
    bind raw    <- stages.load_csv(ctx, "data/orders_sample.csv")
    bind loaded <- validators.validate_all(raw)
    bind n      <- stages.write_postgres(ctx, loaded.orders)
    bind m      <- stages.sync_bigquery(ctx, loaded.orders)
    notifications.notify_success(ctx, n, List.length(loaded.errors))
}
