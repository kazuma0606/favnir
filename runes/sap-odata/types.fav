-- SAP OData v4 接続設定型（v85.2.0）
use sap_odata.delta

type SapConfig = {
    base_url: String,
    client:   String,
    username: String,
    password: String,
    auth:     String
}

-- SAP 接続設定を環境変数から読み取る。
-- fav.toml [sap] の設定は inject_sap_config() によって
-- SAP_BASE_URL / SAP_USER / SAP_PASS / SAP_CLIENT / SAP_AUTH として注入済み。
-- Env.require は Result<String, String> を返す → bind を使う。
-- Env.get_or はデフォルト値付きで String を直接返す → bind 不要。
public fn sap_config_from_env() -> Result<SapConfig, String> {
    bind base_url <- Env.require("SAP_BASE_URL")
    bind username <- Env.require("SAP_USER")
    bind password <- Env.require("SAP_PASS")
    Result.ok(SapConfig {
        base_url,
        username,
        password,
        client: Env.get_or("SAP_CLIENT", "100"),
        auth:   Env.get_or("SAP_AUTH", "basic")
    })
}

-- OData v4 クエリパラメータ（v85.5.0）
type ODataParams = {
    filter:  Option<String>,
    select:  Option<String>,
    expand:  Option<String>,
    top:     Option<Int>,
    skip:    Option<Int>,
    orderby: Option<String>
}

-- ページネーション結果（v87.6.0）
-- items: JSON 行のリスト（各エンティティの JSON 文字列）
-- next_token: @odata.nextLink から抽出した次ページ URL
type PagedResult = {
    items:      List<String>,
    next_token: Option<String>
}

-- 発注伝票ステータス（v88.3.0）
public type PurchaseOrderStatus = Open | PartiallyDelivered | Completed | Cancelled

-- 発注明細型（v88.3.0）
public type PurchaseOrderItem = {
    item_number: Int,
    material_id: String,
    quantity:    Float,
    unit:        String,
    net_price:   Float,
    currency:    String,
    plant:       String
}

-- 発注伝票型（v88.3.0）
-- created_at は SAP OData の CreationDate（ISO 8601 文字列）をそのまま保持する（パース失敗回避のため String）
-- items は $expand=Items 指定時のみ展開される（未指定時は None）
public type PurchaseOrder = {
    po_number:    String,
    vendor_id:    String,
    status:       PurchaseOrderStatus,
    total_amount: Float,
    currency:     String,
    created_at:   String,
    items:        Option<List<PurchaseOrderItem>>
}

-- SAP OData エラーコード列挙型（v85.6.0）
-- HTTP ステータスコードとのマッピング:
--   400 → BadRequest / 401 → Unauthorized / 403 → Forbidden
--   404 → NotFound / 5xx → ServerError / 接続失敗 → NetworkError
type SapErrorCode = NotFound | Unauthorized | Forbidden | BadRequest | ServerError | NetworkError

-- SAP OData エラー型（v85.6.0）
-- OData v4 エラーレスポンス（{"error": {"code": "...", "message": "..."}}）に対応
type SapError = {
    code:    SapErrorCode,
    message: String,
    detail:  Option<String>   -- innererror を単一文字列に簡略化（OData v4 details 配列は v85.9.0 で対応）
}

-- SAP アクセスの統一インターフェース（v90.1.0）
-- ctx.sap フィールドの型として使用する。
-- impl: SapODataClient（本番）/ MockSapClient（テスト・v90.3.0 で実装）
-- NOTE: Favnir の型チェッカーは interface の全メソッド実装を強制しないため、
--       impl ブロックに未実装メソッドがあってもコンパイルエラーにならない。
--       ただし呼び出し時に Result.err スタブが返る。MockSapClient は必要に応じてスタブを追加すること。
public interface SapClient {
    fn business_partners(ctx: SapClient, filter: BusinessPartnerFilter) -> Result<List<BusinessPartner>, String>
    fn business_partner_by_id(ctx: SapClient, id: String) -> Result<BusinessPartner, String>
    fn sales_orders(ctx: SapClient, filter: SalesOrderFilter) -> Result<List<SalesOrder>, String>
    fn materials(ctx: SapClient, filter: MaterialFilter) -> Result<List<Material>, String>
    fn journal_entries(ctx: SapClient, filter: JournalFilter) -> Result<List<JournalEntry>, String>
    fn batch(ctx: SapClient, req: BatchRequest<String>) -> Result<BatchResponse<String>, String>
    fn delta_fetch<T>(ctx: SapClient, entity_set: String, delta_link: Option<String>) -> Result<DeltaResult<T>, String>
}

-- SAP 環境を型安全に表現する直和型（v96.1.0）
-- PRD: 本番環境 / QAS: 品質保証環境 / DEV: 開発・サンドボックス環境
-- Custom(String): 上記以外のカスタム環境（環境名を文字列で保持）
public type SapEnvironment =
    | Prd
    | Qas
    | Dev
    | Custom(String)

-- 環境名文字列から SapEnvironment を生成するユーティリティ（v96.1.0）
-- "PRD" → Prd, "QAS" → Qas, "DEV" → Dev, それ以外 → Custom(name)
public fn SapEnvironment.from_string(name: String) -> SapEnvironment {
    match name {
        "PRD" -> Prd
        "QAS" -> Qas
        "DEV" -> Dev
        _     -> Custom(name)
    }
}
