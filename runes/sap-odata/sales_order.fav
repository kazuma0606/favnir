-- SalesOrder 型定義（v87.1.0）+ クエリ関数（v87.2.0）+ 単一取得（v87.3.0）+ 新規作成（v87.4.0）+ 集計型（v87.5.0）+ Deep Insert（v95.5.0）

use sap_odata.types

public type SalesOrderStatus = Open | InProcess | Completed | Cancelled

public type SalesOrderItem = {
    item_number:  Int,
    material_id:  String,
    description:  String,
    quantity:     Float,
    unit:         String,
    net_amount:   Float,
    currency:     String
}

public type SalesOrder = {
    order_id:     String,
    customer_id:  String,
    status:       SalesOrderStatus,
    total_amount: Float,
    currency:     String,
    sales_org:    String,
    created_at:   String,
    items:        Option<List<SalesOrderItem>>
}

-- SalesOrder クエリ（v87.2.0）

public type SalesOrderFilter = {
    customer_id:    Option<String>,
    status:         Option<SalesOrderStatus>,
    created_after:  Option<String>,
    created_before: Option<String>,
    sales_org:      Option<String>,
    top:            Option<Int>
}

public fn sales_orders(
    cfg:    SapConfig,
    filter: SalesOrderFilter
) -> Result<List<SalesOrder>, String> {
    Result.err("not implemented")
}

