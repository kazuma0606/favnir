// infra/e2e-demo/precision-flow/src/demo.fav
// Precision & Flow E2E Demo — v44.6.0
// Kafka → CEP → Opaque join → Policy gate
//
// NOTE: `opaque type`, `cep pattern`, and `#[max_inflight]` are aspirational
//       design concepts — not yet implemented in the Favnir runtime.
//       This file demonstrates the intended pipeline structure using
//       currently valid syntax.

import rune "kafka"

// ── Refinement type ───────────────────────────────────────────────
type HighValue = Float where |v| v > 1000.0

// ── Opaque types (aspirational — not yet implemented) ─────────────
// opaque type OrderId = String
// opaque type SessionId = String

// ── CEP pattern (aspirational — not yet implemented) ──────────────
// cep pattern HighValueDetected {
//   HighValue within 300
// }

// ── Stage 1: Kafka からイベントを受信 ────────────────────────────
stage IngestEvents: String -> List<Float> = |topic| {
  bind raw <- kafka.consume(topic)
  raw
}

// ── Stage 2: 高額イベントを検出（refinement type でフィルタ）────
stage DetectHighValue: List<Float> -> List<HighValue> = |events| {
  bind detected <- List.filter_map(events, |v| {
    if v > 1000.0 { Some(v) } else { None }
  })
  detected
}

// ── Stage 3: Policy gate（aspirational: #[max_inflight(50)] は未実装）──
stage PolicyGate: List<Float> -> List<Float> = |events| {
  events
}
