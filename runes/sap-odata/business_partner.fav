-- BusinessPartner 型定義（v86.1.0）

use sap_odata.types

public type BusinessPartnerCategory = Person | Organization | Group

public type BusinessPartnerAddress = {
    address_id:  String,
    street:      String,
    city:        String,
    postal_code: String,
    country:     String,
    region:      Option<String>
}

public type BusinessPartner = {
    partner_id:   String,
    name:         String,
    category:     BusinessPartnerCategory,
    country:      String,
    language:     String,
    currency:     String,
    created_at:   String,
    addresses:    Option<List<BusinessPartnerAddress>>
}

