-- SalesOrder 新規作成（v87.4.0）
-- POST 前に x-csrf-token を取得しリクエストヘッダーに付与する

public type NewSalesOrderItem = {
    material_id: String,
    quantity:    Float,
    unit:        String
}

public type NewSalesOrder = {
    customer_id: String,
    sales_org:   String,
    currency:    String,
    items:       List<NewSalesOrderItem>
}

public fn create_sales_order(
    cfg:   SapConfig,
    order: NewSalesOrder
) -> Result<SalesOrder, String> {
    Result.err("not implemented")
}

-- 売上レポート集計型（v87.5.0）

public type CurrencyTotal = {
    currency: String,
    amount:   Float,
    count:    Int
}

public type SalesReport = {
    report_date:  String,
    total_orders: Int,
    total_amount: Float,
    by_currency:  List<CurrencyTotal>
}

-- Deep Insert 型（v95.5.0）
-- SalesOrder と Items を 1 リクエストで作成する OData Deep Insert 専用の入力型
-- NewSalesOrder（v87.4.0）と異なり sales_org を持たない。
-- 省略理由: Deep Insert は既存 SalesOrganization コンテキスト内で実行される想定であり、
-- sales_org は呼び出し元の SapConfig またはセッション設定から OData レイヤーで付与される。
-- 本実装時（後続バージョン）に要件が確定すれば sales_org フィールドを追加すること。
public type NewSalesOrderWithItems = {
    customer_id: String,
    currency:    String,
    items:       List<NewSalesOrderItem>
}

-- SalesOrder Deep Insert（v95.5.0）
-- OData v4 のネスト構造を使い SalesOrder + Items を 1 リクエストで作成する
-- @internal: 未実装スタブ。本実装は後続バージョンで予定。
public fn create_sales_order_deep(
    cfg:   SapConfig,
    order: NewSalesOrderWithItems
) -> Result<SalesOrder, String> {
    Result.err("not implemented")
}
