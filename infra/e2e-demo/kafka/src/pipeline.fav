// infra/e2e-demo/kafka/src/pipeline.fav
// Kafka / MSK E2E デモパイプライン
//
// seq DemoKafkaPipeline = GenerateEvents |> ProduceToKafka |> ConsumeFromKafka |> VerifyResult

import rune "kafka"

type Event = {
    id:      String
    payload: String
}

fn generate_event(id: String) -> Event {
    Event { id: id, payload: String.concat("data-", id) }
}

stage GenerateEvents: Unit -> Result<Int, String> = |_| {
    bind e1 <- kafka.produce("favnir-demo", "evt-001", "data-evt-001")
    bind e2 <- kafka.produce("favnir-demo", "evt-002", "data-evt-002")
    bind e3 <- kafka.produce("favnir-demo", "evt-003", "data-evt-003")
    bind _  <- IO.println("Produced 3 events to favnir-demo")
    Result.ok(3)
}

stage ProduceToKafka: Int -> Result<Int, String> = |n| {
    Result.ok(n)
}

stage ConsumeFromKafka: Int -> Result<String, String> = |_count| {
    kafka.consume_one("favnir-demo", "favnir-consumer-group")
}

stage VerifyResult: String -> Result<Unit, String> = |msg| {
    bind _ <- IO.println(String.concat("Consumed: ", msg))
    Result.ok(())
}

seq DemoKafkaPipeline = GenerateEvents |> ProduceToKafka |> ConsumeFromKafka |> VerifyResult

fn main() -> Result<Unit, String> {
    DemoKafkaPipeline(())
}
